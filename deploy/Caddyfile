# CGCH_SITE 为域名（如 crm.example.com）时自动启用 HTTPS（Let's Encrypt）；未设置时按 IP 用 HTTP 访问
{$CGCH_SITE::80} {
	encode zstd gzip

	# 安全响应头：禁止浏览器猜测文件类型、禁止被其他网站用框架嵌入（防点击劫持）、跨站跳转只带域名、
	# 只允许通过 HTTPS 访问（HTTP 访问时浏览器会忽略此项）、关闭用不到的摄像头 / 定位等权限，并去掉服务器版本信息。
	# 官网在线客服是外部网站引用的脚本（不是框架嵌入），不受影响
	header {
		# 等后端响应后再设置，避免和后端自带的同名响应头重复
		defer
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
		X-XSS-Protection "0"
		-Server
		-X-Powered-By
	}

	# 每个请求一个编号，同时传给后端，出问题时按编号对日志
	header X-Request-ID {http.request.uuid}
	request_header X-Request-ID {http.request.uuid}

	# 对外公开页面：产品介绍、隐私政策、服务条款、数据删除说明（平台审核要求公开可访问）
	@public path_regexp pub ^/(about|privacy|terms|data-deletion)/?$
	rewrite @public /admin-api/public/site/{re.pub.1}

	handle /admin-api/* {
		reverse_proxy backend:48080 {
			transport http {
				read_timeout 180s
			}
		}
	}

	# 打包出来的 js / css / 图片文件名带内容哈希，内容变了文件名就变：让浏览器缓存一年、不再回源校验，
	# 再次打开网站时这些文件直接从本地读取（服务器在海外时能省掉几百次往返）。index.html 每次都校验，保证升级后立即生效
	@hashed path_regexp hashed ^/(js|jse|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|mp3|json)/[^/]+-[A-Za-z0-9_-]{6,}\.[a-z0-9]+$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server {
			precompressed br
		}
	}

	request_body {
		max_size 30MB
	}
}
