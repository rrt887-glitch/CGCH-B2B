# 应用标题
VITE_APP_TITLE=草根出海

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=cgch-v3

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 是否开启模拟数据
VITE_NITRO_MOCK=false

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=false

# 百度统计
VITE_APP_BAIDU_CODE =

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# API 加解密
# API 加密：与后端 CGCH_API_ENCRYPT_ENABLE 同时开启；密钥在打包时通过同名环境变量传入，不要写在这里
VITE_APP_API_ENCRYPT_ENABLE = false
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY = 
VITE_APP_API_ENCRYPT_RESPONSE_KEY = 

# 百度地图
VITE_BAIDU_MAP_KEY=