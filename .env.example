# ==================================================================================
# CGCH 生产环境变量示例。复制为 .env（已在 .gitignore 中，不会提交），填入真实值。
# 生成随机密钥：openssl rand -base64 24
# ==================================================================================

# ---------- 必填 ----------
# 字段加密密钥：加密数据库里的邮箱密码、WhatsApp 令牌、大模型 API Key 等。
# 必须正好 16、24 或 32 个字符（推荐 openssl rand -base64 24，正好 32 位）；上线后不要再改（改了以后已加密的数据会解不开，需要重新录入）。
CGCH_FIELD_ENCRYPT_KEY=

# 数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
DB_USERNAME=cgch
DB_PASSWORD=

# Redis（不对公网开放时可不设密码，但强烈建议设置）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 对外访问地址（支付回调、WhatsApp Webhook 等要用公网 HTTPS 地址）
PUBLIC_BASE_URL=https://crm.example.com

# ---------- 可选 ----------
SERVER_PORT=48080
# 登录图片验证码，生产环境建议开启
CAPTCHA_ENABLE=true
# 日志文件路径
# LOG_FILE=/var/log/cgch/yudao-server.log

# API 加密（默认关闭）：开启时前后端要用同一对 16/24/32 位密钥，前端在打包时传入同名 VITE_ 变量
CGCH_API_ENCRYPT_ENABLE=false
CGCH_API_ENCRYPT_REQUEST_KEY=
CGCH_API_ENCRYPT_RESPONSE_KEY=

# docker compose 启动 MySQL 时使用的 root 密码（只用于 deploy/docker-compose.prod.yml）
MYSQL_ROOT_PASSWORD=

# ===== 邮箱 OAuth 授权（可选，配置后渠道管理里 Gmail / Outlook 出现「授权登录」） =====
# 回调地址：${PUBLIC_BASE_URL}/admin-api/channel/oauth/google/callback 和 .../microsoft/callback
CGCH_OAUTH_GOOGLE_CLIENT_ID=
CGCH_OAUTH_GOOGLE_CLIENT_SECRET=
CGCH_OAUTH_MICROSOFT_CLIENT_ID=
CGCH_OAUTH_MICROSOFT_CLIENT_SECRET=

# ===== Facebook 主页 / Instagram 私信（可选，配置后渠道管理里出现「Facebook 登录授权」） =====
# 授权回调：${PUBLIC_BASE_URL}/admin-api/channel/meta/oauth/callback
# Webhook：${PUBLIC_BASE_URL}/admin-api/channel/meta/webhook（验证令牌填下面的值）
CGCH_META_APP_ID=
CGCH_META_APP_SECRET=
CGCH_META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp 嵌入式注册（客户在系统里用 Facebook 弹窗自己开通号码）的配置编号；需先成为 Meta 技术服务商
CGCH_META_WA_CONFIG_ID=

# ===== WhatsApp 经 YCloud 接入（推荐；客户扫码绑定号码，不需要自己成为 Meta 技术服务商） =====
# YCloud 控制台 → Developers → API Key；Webhook 接收地址：${PUBLIC_BASE_URL}/admin-api/channel/ycloud/webhook
# 订阅 whatsapp.inbound_message.received、whatsapp.message.updated、whatsapp.smb.message.echoes、
# whatsapp.business_account.updated，把返回的签名密钥填到 CGCH_YCLOUD_WEBHOOK_SECRET
CGCH_YCLOUD_API_KEY=
CGCH_YCLOUD_WEBHOOK_SECRET=

# ===== 对外公开页面（隐私政策、服务条款等）里的运营主体信息：平台审核会检查，请填真实信息 =====
CGCH_PRODUCT_NAME=CGCH
CGCH_COMPANY_NAME=
CGCH_COMPANY_NAME_EN=
CGCH_CONTACT_EMAIL=
CGCH_COMPANY_ADDRESS=
